+/**
+ * The board title; for the owner, a click turns it into an input. Enter or
+ * leaving the field saves, Escape cancels, an empty name is ignored.
+ */
+function BoardName({ board, editable }: Readonly<{ board: Board; editable: boolean }>) {
+  const renameBoard = useTasks((s) => s.renameBoard);
+  const [editing, setEditing] = useState(false);
+  const [draft, setDraft] = useState(board.name);
+
+  useEffect(() => {
+    if (!editing) setDraft(board.name);
+  }, [board.name, editing]);
+
+  const commit = useCallback(() => {
+    setEditing(false);
+    const name = draft.trim();
+    if (!name || name === board.name) return;
+    renameBoard(board.boardId, name).catch(() => {
+      /* the store reverted the name and recorded the error */
+    });
+  }, [board.boardId, board.name, draft, renameBoard]);
+
+  if (editing) {
+    return (
+      <input
+        autoFocus
+        aria-label="Board name"
+        value={draft}
+        maxLength={MAX_BOARD_NAME_LENGTH}
+        onChange={(e) => setDraft(e.target.value)}
+        onBlur={commit}
+        onKeyDown={(e) => {
+          if (e.key === "Enter") {
+            e.preventDefault();
+            commit();
+          } else if (e.key === "Escape") {
+            e.preventDefault();
+            setDraft(board.name);
+            setEditing(false);
+          }
+        }}
+        className="min-w-0 max-w-xs rounded-md border border-line bg-surface px-2 py-0.5 text-lg font-semibold text-ink outline-none focus:ring-2 focus:ring-accent"
+      />
+    );
+  }
+
+  if (!editable) {
+    return <h2 className="truncate text-lg font-semibold text-ink">{board.name}</h2>;
+  }
+  return (
+    <button
+      type="button"
+      title="Rename board"
+      onClick={() => setEditing(true)}
+      className="truncate rounded-md px-1 text-left text-lg font-semibold text-ink hover:bg-surface-hover"
+    >
+      <h2 className="truncate">{board.name}</h2>
+    </button>
+  );
+}
