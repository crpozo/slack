# Copy to .env and fill in with the outputs of `pnpm deploy:dev`.
VITE_WS_URL=wss://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/prod
VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional since Phase 5.1 (the backend serves the user directory). Only needed to list
# people who have never signed in: comma-separated `email=sub` (Cognito user id).
VITE_USERS=persona1@mindfultech.ec=<cognito-sub>,persona2@mindfultech.ec=<cognito-sub>
