{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MindfulTech Slack",
  "version": "../package.json",
  "identifier": "ec.mindfultech.slack",
  "build": {
    "frontendDist": "https://slack.mindfultech.ec"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "MindfulTech Slack",
        "url": "https://slack.mindfultech.ec",
        "create": false,
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "transparent": true,
        "theme": "Dark",
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "app"],
    "category": "Productivity",
    "shortDescription": "MindfulTech Slack",
    "longDescription": "Team chat, voice and video calls, and tasks for MindfulTech.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "entitlements": "./Entitlements.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
